APP_NAME="UCW App"
APP_ENV=production
APP_KEY=base64:generate_with_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ucw_app
DB_USERNAME=ucw_app
DB_PASSWORD=change_me_postgres_password
POSTGRES_PASSWORD=change_me_postgres_password
DB_SSLMODE=prefer

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ucw-production
REVERB_APP_KEY=change_me_reverb_key
REVERB_APP_SECRET=change_me_reverb_secret
REVERB_HOST=your-domain.example
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

PAYMENT_GATEWAY=pakasir
PAKASIR_PROJECT=your_pakasir_project_slug
PAKASIR_API_KEY=your_pakasir_api_key
PAKASIR_MODE=production
PAKASIR_BASE_URL=https://app.pakasir.com

# Midtrans is retained for future migration only. Do not set PAYMENT_GATEWAY=midtrans for current production.
MIDTRANS_SERVER_KEY=placeholder_for_future_midtrans_server_key
MIDTRANS_CLIENT_KEY=placeholder_for_future_midtrans_client_key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT=10

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

DB_CONNECTION=pgsql
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.harjzteuctunohmnbwcg
DB_PASSWORD=UcwApp___12
DB_SSLMODE=require